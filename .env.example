# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- environment
# development | staging | production
# In production, startup refuses to continue unless API_KEY_HASHES is set,
# a provider key is present, CORS is not "*", and DATABASE_URL is not localhost.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json          # json in production, console for a readable local log

# ------------------------------------------------------------------- storage
DATABASE_URL=postgresql+asyncpg://modelops:modelops_dev@localhost:5432/modelops_dev
# Optional. Without it, provider health and rate limits fall back to
# per-process state — correct for one replica, approximate for several.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------ providers
# Set at least one. Models whose vendor key is absent are skipped at startup,
# so a single-vendor deployment starts cleanly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --------------------------------------------------------------------- access
# Comma-separated SHA-256 hashes of your API keys. Plaintext keys are never
# stored or configured, so a leaked env dump hands over nothing usable.
#   modelops hash-key mo_live_your_key_here
# Empty means the API runs unauthenticated. That is fine locally and refused
# in production.
API_KEY_HASHES=

RATE_LIMIT_PER_MINUTE=120

# Who sees which numbers on /metrics.
#   key        (default) each API key sees only its own spend and volume
#   deployment every key sees the whole deployment
# Leave as "key" for anything multi-tenant. Set "deployment" for a single team
# sharing staging/prod/CI keys that wants one combined picture.
METRICS_SCOPE=key

# Comma-separated allowed origins for the dashboard. Leave empty to disable
# CORS entirely; "*" is rejected in production.
CORS_ORIGINS=

# ------------------------------------------------------------------- routing
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=2
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_UNHEALTHY_TTL_SECONDS=60
EVAL_CONCURRENCY=8

# --------------------------------------------------------------------- privacy
# Off by default and deliberately so. With it on, the first 200 characters of
# each prompt are written to routing_decisions.prompt_preview. Token counts,
# cost and latency are always recorded; prompt bodies are not.
STORE_PROMPTS=false

# --------------------------------------------------------------------- alerts
# Optional. Alerts are always written to the database; this only adds delivery.
SLACK_WEBHOOK_URL=
